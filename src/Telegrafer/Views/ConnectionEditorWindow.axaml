<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500"
        x:Class="Telegrafer.Views.ConnectionEditorWindow"
        Icon="/Assets/app-icon.ico"
        Title="{Binding Title}"
        Width="500" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40">
  <DockPanel>
    <Panel DockPanel.Dock="Top">
      <Border Classes="dialog-titlebar" IsHitTestVisible="False">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="20,0" VerticalAlignment="Center"/>
      </Border>
      <Button Classes="icon" HorizontalAlignment="Right" Margin="0,0,8,0" ToolTip.Tip="Schließen"
              Command="{Binding CancelCommand}">
        <PathIcon Data="{StaticResource close_icon}"/>
      </Button>
    </Panel>

    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="dialog" Content="Abbrechen" IsCancel="True" Command="{Binding CancelCommand}"/>
        <Button Classes="dialog accent" Content="Speichern" IsDefault="True" Command="{Binding SaveCommand}"/>
      </StackPanel>
    </Border>

    <StackPanel Margin="20,16,20,20" Spacing="14">
      <StackPanel Spacing="5">
        <TextBlock Classes="field-label" Text="Name"/>
        <TextBox Name="NameBox" Text="{Binding Name}" Watermark="z. B. Steuerung 1 – ohne Namen wird die Adresse angezeigt"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,12,130">
        <StackPanel Spacing="5">
          <TextBlock Classes="field-label" Text="Host oder IP-Adresse"/>
          <TextBox Classes="address" MinWidth="0" MaxWidth="1000" HorizontalAlignment="Stretch"
                   Text="{Binding Host}" Watermark="z. B. 192.168.1.10 oder plc-01"/>
          <TextBlock Classes="error" Text="{Binding HostMessage}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="5">
          <TextBlock Classes="field-label" Text="Port"/>
          <TextBox Classes="address" MinWidth="0" HorizontalAlignment="Stretch"
                   Text="{Binding Port}" Watermark="z. B. 5000"/>
          <TextBlock Classes="error" Text="{Binding PortMessage}"/>
        </StackPanel>
      </Grid>

      <StackPanel Spacing="5">
        <TextBlock Classes="field-label" Text="Gruppe"/>
        <ComboBox HorizontalAlignment="Stretch" Items="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"/>
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Classes="field-label" Text="Beschreibung (optional)"/>
        <TextBox Text="{Binding Description}" Watermark="z. B. Halle 3, Testumgebung"/>
      </StackPanel>

      <TextBlock Classes="section-title" Text="PROTOKOLL" Margin="0,6,0,-4"/>

      <CheckBox IsChecked="{Binding AddStxEtx, Mode=TwoWay}" Content="STX und ETX automatisch hinzufügen"
                ToolTip.Tip="Sendet 0x02 vor und 0x03 nach jedem Telegramm, ohne sie zu verdoppeln."/>

      <Grid ColumnDefinitions="*,12,*">
        <StackPanel Spacing="5">
          <TextBlock Classes="field-label" Text="Zeilenende"/>
          <ComboBox HorizontalAlignment="Stretch" Items="{Binding LineEndings}" SelectedItem="{Binding SelectedLineEnding, Mode=TwoWay}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="5">
          <TextBlock Classes="field-label" Text="Zeichenkodierung"/>
          <ComboBox HorizontalAlignment="Stretch" Items="{Binding Encodings}" SelectedItem="{Binding SelectedEncoding, Mode=TwoWay}"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
